% PACKAGES %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage[breakable,skins,raster]{tcolorbox}    

\RequirePackage{\CurrentFilePath/SMbeamer_colors}
\RequirePackage{varwidth} 

\RequirePackage{lstautogobble} % to remove indentation in lstlisting


% BOXES %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% General boxes ----------------------------------
\tcbset{  % define styles
  styleBoxInfo/.style={
    enhanced,
    top=0.6mm, bottom=0.6mm, left=0.6mm, right=0.6mm,
    boxrule=0.5pt,
    arc=0mm,
    colframe=colorBoxInfo, coltext=colorTextLight,
    colback=colorFrame, colbacktitle=colorFrame,
    coltitle=colorTextLight,
    hbox,
  },
  styleboxTheorem/.style={
    enhanced,
    top=0.8mm, bottom=0.8mm, left=0.8mm, right=0.8mm,
    boxrule=0.75pt,
    arc=0mm,
    colframe=colorAccent!50, coltext=colorText,
    colback=colorAccentVeryLight, colbacktitle=colorAccentVeryLight,
    coltitle=colorText,
    fuzzy shadow={0mm}{0mm}{-0.5mm}{0.2mm}{black!30!white},
  },
  styleboxKey/.style={
    enhanced,
    top=0.8mm, bottom=0.8mm, left=0.8mm, right=0.8mm,
    boxrule=0.5pt,
    arc=0mm,
    colframe=colorKeyFrame, coltext=colorText,
    colback=colorKeyBg,
    fuzzy shadow={0mm}{0mm}{-0.5mm}{0.2mm}{black!30!white},
    hbox,
  },
}
\newcommand{\boxInfo}[1]{%
  \raggedleft\begin{tcolorbox}[styleBoxInfo]%
    \scriptsize #1%
  \end{tcolorbox}\par
}
\newcommand{\boxTheorem}[2][]{%
  \begin{tcolorbox}[styleboxTheorem]%
    \if\relax\detokenize{#1}\relax
      #2%
    \else
      \textbf{#1.}\ \ #2%
    \fi
  \end{tcolorbox}
}
\newcommand{\boxKey}[1]{%
  \centering\begin{tcolorbox}[styleboxKey]%
    \begin{varwidth}{0.8\textwidth}\centering\small%
    #1%
    \end{varwidth}
  \end{tcolorbox}
}


% Code boxes -------------------------------------
\lstset{
	autogobble=true,
	resetmargins=true,
	backgroundcolor=\color{colorBackgroundCode},
	frame=single, framerule=0.75pt, rulecolor=\color{colorFrameCode},
	language=python,
	basicstyle=\footnotesize\ttfamily,
	keywordstyle=\color{colorKeywordCode},
	stringstyle=\color{colorStringCode},
	commentstyle=\itshape\color{colorCommentCode},
	numbers=left,
	firstnumber=auto,
	numberstyle=\tiny\color{colorLineNumber},
	xleftmargin=14pt, xrightmargin=5pt,
	framexleftmargin=1pt, framexrightmargin=1pt, framextopmargin=1pt, framexbottommargin=1pt,
	breaklines=true,
	keepspaces=true,
	tabsize=4,
	showspaces=false,
	showstringspaces=false,
	showtabs=false, tab={\color{colorTabCode}$\to$},
	mathescape=true,
}

\lstnewenvironment{boxCode}[1][]{\lstset{#1}}{}  % an alias for lstlisting with options

\NewTotalTCBox{\inlineCode}{ O{} v }{verbatim, on line,
	boxsep=2pt, left=0pt, right=0pt, top=0pt, bottom=0pt, arc=0mm, boxrule=0.75pt,
	colframe=colorFrameCode, colback=colorBackgroundCode}{\lstinline[#1]^#2^}