% PACKAGES %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage[ruled,vlined,linesnumbered]{algorithm2e}  % algorithms
\RequirePackage[svgnames]{xcolor}       % colors


% ALGORITHMS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Remove right hand margin in algorithm (might need \RequirePackage{etoolbox})
\patchcmd{\@algocf@start}% <cmd>
  {-1.5em}% <search>
