  {}{}% <success><failure>

\SetKwComment{tcc}{ {$\triangleright$} }{}  % comment C style
\SetKwComment{tcp}{ {$\triangleright$} }{}  % comment C++ style
\newcommand{\myCommentStyle}[1]{\footnotesize\sffamily\textcolor{gray}{#1}}
\SetCommentSty{myCommentStyle}